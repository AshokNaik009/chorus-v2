{
  "name": "leap-chorus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.18.0",
  "bin": {
    "leap-chorus": "./packages/client/dist/main.js"
  },
  "scripts": {
    "build": "tsc -b && chmod +x packages/client/dist/main.js",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "prepare": "node scripts/fix-node-pty-permissions.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
